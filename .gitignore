# ------------------------------
# Python bytecode and caches
# ------------------------------
__pycache__/
*.py[cod]
*$py.class

# ------------------------------
# Virtual environments
# ------------------------------
.venv/
venv/
env/
ENV/

# ------------------------------
# Build / packaging artifacts
# ------------------------------
build/
dist/
node_modules/
site/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ------------------------------
# Test, coverage, profiling
# ------------------------------
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.prof
*.profraw
*.profdata

# ------------------------------
# Type checker / linter caches
# ------------------------------
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ------------------------------
# Jupyter
# ------------------------------
.ipynb_checkpoints/

# ------------------------------
# IDE / editor files
# ------------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------------
# OS files
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Logs and runtime outputs
# ------------------------------
*.log
*.pid
logs/

# ------------------------------
# Local environment/config
# ------------------------------
.env
.env.*
!.env.example

# ------------------------------
# Common local data/cache dirs
# ------------------------------
.cache/
tmp/
temp/

# ------------------------------
# Runtime-generated robot memory store
# ------------------------------
data/memory.json

# ------------------------------
# Project-specific generated artifact seen in workspace
# ------------------------------
default.profraw
